{
    "name": "wabsnet",
    "version": "0.0.1",
    "description": "",
    "author": "Patrick whayeber <gg44whirlpool@outlook.com>",
    "scripts": {
        "test": "NODE_ENV=test jest",
        "start": "ts-node src/server.ts",
        "start-electron": "tsc -p ./tsconfig.build.json && electron dist/index.js",
        "cmd": "ts-node bin/send-command.ts",
        "build": "yarn build:ts",
        "build:ts": "tsc -p ./tsconfig.build.json",
        "app:dir": "electron-builder --dir",
        "app:dist": "tsc -p ./tsconfig.build.json && electron-builder",
        "postinstall": "electron-builder install-app-deps"
    },
    "main": "./dist/index.js",
    "bin": "./dist/server.js",
    "build": {
        "asar": true,
        "files": ["./dist/**/*"],
        "appId": "com.wabsnet.app",
        "generateUpdatesFilesForAllChannels": true,
        "files": [
            "dist/**/*",
            "package.json"
        ],
        "extraResources": ["content/"],
        "directories": {
            "output": "build"
        },
        "linux": {
            "target": [
                "deb",
                "zip"
            ],
            "maintainer": "gg44whirlpool@outlook.com",
            "category": "Utility",
            "icon": "content/logo.png"
        }
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@faker-js/faker": "^8.3.1",
        "@swc/core": "1.3.44",
        "@types/electron": "^1.6.10",
        "@types/jest": "^29.2.1",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/node": "^18.11.9",
        "@typescript-eslint/eslint-plugin": "5.45.1",
        "@typescript-eslint/parser": "5.45.1",
        "dotenv-cli": "7.2.1",
        "dotenv-flow": "3.2.0",
        "electron": "^28.1.0",
        "electron-builder": "^24.9.1",
        "eslint": "8.26.0",
        "husky": "8.0.1",
        "jest": "^29.2.2",
        "lint-staged": "13.0.3",
        "pino-pretty": "9.1.1",
        "prettier": "2.8.0",
        "swc-node": "1.0.0",
        "ts-jest": "^29.0.3",
        "ts-node": "^10.9.1",
        "ts-node-dev": "^2.0.0",
        "typescript": "^4.9.3"
    },
    "dependencies": {
        "chalk": "^4.1.2",
        "jsonwebtoken": "^9.0.2",
        "signal-exit": "^4.1.0",
        "terminal-art": "^1.4.3",
        "xpipe": "^1.0.5"
    }
}
